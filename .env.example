# --- Database (Neon Postgres or any Postgres) -------------------------------
# Pooled connection string used by the app at runtime.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# For the Tilt / docker-compose local stack, use:
#   DATABASE_URL="postgresql://user:password@localhost:5433/open_crosswords"

# --- better-auth -----------------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-me-with-a-32-byte-random-string"
# Public base URL of the app (no trailing slash).
BETTER_AUTH_URL="http://localhost:3000"

# --- Client address (rate limiting) --------------------------------------
# The single header the hosting platform sets to the real client address. Only
# this one is read, because any header the app will read is one a caller can
# send when the platform does not overwrite it. Vercel: leave as is.
# Cloudflare: "cf-connecting-ip". Most reverse proxies: "x-real-ip". Exposing
# the app directly, with nothing in front: "" — no header is then believed, so
# every caller shares one bucket and ten sign-in requests a minute from anyone
# hold everyone else out. Prefer a proxy that sets one of the headers above. A production server outside Vercel
# refuses to start until this (or AUTH_TRUSTED_PROXIES below) is stated, rather
# than fall back to trusting a header nothing overwrites.
AUTH_IP_HEADER="x-vercel-forwarded-for"

# Addresses or CIDR ranges of the proxies in front of this app. Set this only
# when the app is reachable only through them and they set no header above:
# x-forwarded-for is then read instead, walked from the right past these hops.
AUTH_TRUSTED_PROXIES=""

# --- Admin access --------------------------------------------------------
# Comma-separated list of emails allowed into /admin. A signed-in user whose
# verified email is on this list can manage the question library.
ADMIN_EMAILS="you@example.com"

# --- AI-assisted question drafting (optional) ----------------------------
# When unset, the "AI draft" admin panel is disabled and the endpoint returns 501.
ANTHROPIC_API_KEY=""
AI_MODEL="claude-sonnet-5"
