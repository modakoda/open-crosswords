# --- Database (Neon Postgres or any Postgres) -------------------------------
# Pooled connection string used by the app at runtime.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# For the Tilt / docker-compose local stack, use:
#   DATABASE_URL="postgresql://user:password@localhost:5433/open_crosswords"

# --- better-auth -----------------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-me-with-a-32-byte-random-string"
# Public base URL of the app (no trailing slash).
BETTER_AUTH_URL="http://localhost:3000"

# --- Reverse proxies (optional) ------------------------------------------
# Addresses or CIDR ranges of the proxies in front of this app. Set this only
# when the app is reachable only through them, and only if they do not already
# set x-vercel-forwarded-for / cf-connecting-ip / x-real-ip. It lets sign-in
# rate limiting read the client IP from a multi-hop x-forwarded-for instead of
# throttling every visitor through one shared bucket.
AUTH_TRUSTED_PROXIES=""

# --- Admin access --------------------------------------------------------
# Comma-separated list of emails allowed into /admin. A signed-in user whose
# verified email is on this list can manage the question library.
ADMIN_EMAILS="you@example.com"

# --- AI-assisted question drafting (optional) ----------------------------
# When unset, the "AI draft" admin panel is disabled and the endpoint returns 501.
ANTHROPIC_API_KEY=""
AI_MODEL="claude-sonnet-5"
